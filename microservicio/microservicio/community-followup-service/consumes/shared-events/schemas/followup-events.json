{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Followup Events",
  "type": "object",
  "required": ["event_name", "event_version", "producer", "payload"],
  "properties": {
    "event_name": {
      "type": "string",
      "enum": ["followup.created", "followup.updated", "followup.completed", "compliance.alert"]
    },
    "event_version": { "type": "string" },
    "producer": { "type": "string" },
    "payload": {
      "type": "object",
      "required": ["followup_id", "family_id", "record_number", "compliance_status"],
      "properties": {
        "followup_id": { "type": "integer" },
        "family_id": { "type": "integer" },
        "record_number": { "type": "string" },
        "compliance_status": { "type": "string" }
      }
    }
  }
}
